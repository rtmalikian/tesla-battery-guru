# Tesla Fleet API application credentials (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=<redacted>
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your vehicles: name=VIN pairs, comma-separated
TBG_VEHICLES=Model Y=YOUR_VIN_HERE,Model 3=SECOND_VIN_HERE

# The OpenAI-compatible server THIS app exposes
TBG_SERVER_HOST=127.0.0.1
TBG_SERVER_PORT=8649
# Optional: require Authorization: Bearer <key> on /v1/* (recommended if exposed on LAN)
TBG_SERVER_API_KEY=<redacted>
TBG_MODEL_ID=tesla-battery-guru

# Pluggable LLM backend — any OpenAI-compatible API. Default: local Ollama.
# The app works FULLY without a backend (rules engine); the LLM only explains
# the health stats in free-form words. Vehicle data is sent only to
# this backend — nowhere else. This app never commands a car.
TBG_AI_BASE_URL=http://localhost:11434/v1
TBG_AI_API_KEY=<redacted>
TBG_AI_MODEL=llama3.1
# auto = rules first, LLM for the rest | always = LLM first | never = rules only
TBG_AI_MODE=auto
TBG_AI_TIMEOUT_SECONDS=20

TBG_EMBEDDING_DIM=384
TBG_TOKEN_FILE=~/.tbg/tokens.json
# 1 = preview actions instead of storing them
TBG_DRY_RUN=0

# Battery-health rules — plain words, set by `tbguru setup`
# Nominal usable pack size when new, in kWh (Model 3/Y Long Range ~75,
# Standard Range ~60, Model S/X ~100). Degradation is measured against this.
TBG_NOMINAL_PACK_KWH=75
# Everyday charge limit you aim for (Tesla's daily guidance is 80%)
TBG_DAILY_LIMIT_PCT=80
TBG_DATA_FILE=~/.tbg/battery.jsonl
